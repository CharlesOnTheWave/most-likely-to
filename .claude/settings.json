{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Read",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(npx wrangler deploy)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler secret *)",
      "Bash(npx wrangler rollback)",
      "Bash(npx wrangler rollback *)",
      "Bash(npx wrangler versions deploy)",
      "Bash(npx wrangler versions deploy *)",
      "Bash(npx wrangler delete)",
      "Bash(npx wrangler delete *)",
      "Bash(npx supabase db *)",
      "Bash(npx supabase test*)",
      "Bash(supabase test*)",
      "Bash(npx supabase migration up*)",
      "Bash(npx supabase migration down*)",
      "Bash(npx supabase migration repair*)",
      "Bash(npm run live-probe*)",
      "Bash(node scripts/live-sync-probe*)",
      "Bash(node ./scripts/live-sync-probe*)",
      "Bash(node *live-sync-probe*)",
      "Bash(npm *live-probe*)",
      "Bash(npm run smoke*)",
      "Bash(npm *smoke*)",
      "Bash(BASE_URL=* npm*smoke*)",
      "Bash(SMOKE_OAUTH=* npm*smoke*)",
      "Bash(SMOKE_ROUND=* npm*smoke*)",
      "Bash(SMOKE_GAME=* npm*smoke*)",
      "Bash(SMOKE_LIST=* npm*smoke*)",
      "Bash(node scripts/smoke*)",
      "Bash(node ./scripts/smoke*)",
      "Bash(node *smoke.mjs*)",
      "Bash(npm run keep-awake*)",
      "Bash(npm *keep-awake*)",
      "Bash(node scripts/keep-supabase-awake*)",
      "Bash(node ./scripts/keep-supabase-awake*)",
      "Bash(node *keep-supabase-awake*)",
      "Bash(node --run*)",
      "Bash(node *--run*)",
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)"
    ],
    "deny": ["Bash(rm -rf *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/.claude/hooks/lint-edited-file.mjs\"",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/.claude/hooks/related-tests.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/.claude/hooks/end-of-turn.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
