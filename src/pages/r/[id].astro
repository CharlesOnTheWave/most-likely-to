---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/room/AppHeader.astro";
import RoomLobby from "@/components/room/RoomLobby";
import RoomMessage from "@/components/room/RoomMessage.astro";
import { roomErrorMessage } from "@/lib/rooms/errors";
import { hostLinkToken, roomLobby } from "@/lib/rooms/server";
import type { LobbyState } from "@/lib/rooms/shared";
import { playerCookieName, UUID_PATTERN } from "@/lib/rooms/tokens";
import { createClient, getPublicSupabaseConfig } from "@/lib/supabase";

// The room for its host (session) or a player (the cookie from joining). Anyone else, a malformed id and a room that
// does not exist get the same 404, so the page does not tell which rooms exist. The island keeps the list live: the
// publishable key reaches it as props, only for the room's Realtime channel (AGENTS.md); null means polling only.
type Page =
  | { kind: "lobby"; roomId: string; lobby: LobbyState; linkUrl: string | null }
  | { kind: "outside" }
  | { kind: "error"; reason: string };

async function loadPage(roomId: string): Promise<Page> {
  if (!UUID_PATTERN.test(roomId)) return { kind: "outside" };
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return { kind: "error", reason: "service_unavailable" };

  const result = await roomLobby(supabase, roomId, Astro.cookies.get(playerCookieName(roomId))?.value);
  if (!result.ok) return { kind: "error", reason: result.reason };
  if (!result.lobby) return { kind: "outside" };

  // Only the host reads the link code (RLS on rooms), and only while the room is open.
  let linkUrl: string | null = null;
  if (result.lobby.role === "host" && result.lobby.status === "lobby") {
    const link = await hostLinkToken(supabase, roomId);
    if (link.ok && link.linkToken) linkUrl = `${Astro.url.origin}/j/${link.linkToken}`;
  }
  return { kind: "lobby", roomId, lobby: result.lobby, linkUrl };
}

const page = await loadPage(Astro.params.id ?? "");
const realtime = getPublicSupabaseConfig();
if (page.kind === "outside") {
  Astro.response.status = 404;
} else if (page.kind === "error") {
  Astro.response.status = page.reason === "service_unavailable" ? 503 : 500;
}
---

<Layout title={page.kind === "outside" ? "Nie jesteś w tym pokoju" : "Pokój"}>
  <AppHeader />
  <main class="mx-auto flex w-full max-w-lg flex-col gap-6 px-4 py-8">
    {page.kind === "lobby" && (
      <RoomLobby roomId={page.roomId} initial={page.lobby} linkUrl={page.linkUrl} realtime={realtime} client:load />
    )}
    {page.kind === "outside" && <RoomMessage title="Nie jesteś w tym pokoju." text="Poproś hosta o link." />}
    {page.kind === "error" && (
      <RoomMessage title="Nie udało się otworzyć pokoju." text={roomErrorMessage(page.reason)} />
    )}
  </main>
</Layout>
