---
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/room/AppHeader.astro";
import JoinForm from "@/components/room/JoinForm";
import JoinWaiting from "@/components/room/JoinWaiting";
import Landing from "@/components/room/Landing.astro";
import NewGameForm from "@/components/room/NewGameForm";
import OpenRoomNotice from "@/components/room/OpenRoomNotice.astro";
import { ROOM_FRAME } from "@/components/room/room-frame";
import RoomCard from "@/components/room/RoomCard.astro";
import RoomMessage from "@/components/room/RoomMessage.astro";
import RoomScreen from "@/components/room/RoomScreen";
// Server only (lessons.md): the islands get just the id and name of each category.
import { CATEGORIES } from "@/data/questions";
import { roomErrorMessage } from "@/lib/rooms/errors";
import type { LobbyPlayer, RoomView } from "@/lib/rooms/shared";

// Every state of the room screens side by side: the visual gate of /10x-ui. Sample data only: no database queries,
// no Realtime, no polling, no reports; the round's buttons only answer "ok" on this page (RoomScreen's preview). Local
// only; a production build answers an empty 404.
// From lg (1024 px) each room state (/r/…) is as wide as the page (ROOM_FRAME, one per row), because its lg: classes
// answer the window's width, not the frame's; below lg every frame is 512 px, as before. The header, / and /j/… keep
// their 512 px frames; the wide header and the host's bar at the window's bottom edge are on /dev/room-window.
// (Status instead of an early `return`, which crashes typescript-eslint's no-misused-promises in .astro files.)
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

const categories = CATEGORIES.map(({ id, name }) => ({ id, name }));
const newGameCard = {
  title: "Nowa gra",
  description: "Wpisz swój nick i wybierz kategorie. Link dla graczy dostaniesz od razu.",
};
const joinCard = { title: "Dołącz do gry", description: "Wpisz nick i jesteś w grze. Konto nie jest potrzebne." };
// /j/… during a game (S-08): the latecomer's request form, and the same after "Odrzuć".
const requestCard = {
  title: "Poproś o wejście",
  description: "Gra już trwa, więc host musi cię wpuścić. Wpisz nick i poproś o wejście.",
};
const requestAgainCard = { title: "Host cię nie wpuścił.", description: "Możesz poprosić o wejście jeszcze raz." };

// Sample room, link and players; the link has the real length (22 base64url characters after /j/).
const ROOM_ID = "3f2b8c1e-7a4d-4e9b-9c2a-5d6e7f8a9b0c";
const LINK_TOKEN = "Xq3vL9tR2mWb7KpZ0aYc_e";
const LINK_URL = `https://most-likely-to.charlesonthewave.workers.dev/j/${LINK_TOKEN}`;
const hostAlone: LobbyPlayer[] = [{ nick: "Ola", host: true }];
const twoPlayers: LobbyPlayer[] = [
  { nick: "Ola", host: true },
  { nick: "Bartek", host: false },
];
const fewPlayers: LobbyPlayer[] = [
  { nick: "Ola", host: true },
  { nick: "Bartek", host: false },
  { nick: "Kasia 🎉", host: false },
];
// Eight players, with a nick of exactly 20 characters (nickLength) and one with an emoji.
const eightPlayers: LobbyPlayer[] = [
  { nick: "Ola", host: true },
  { nick: "Bartek", host: false },
  { nick: "Najdłuższy nick 20zn", host: false },
  { nick: "Kasia 🎉", host: false },
  { nick: "Zosia", host: false },
  { nick: "Kuba", host: false },
  { nick: "Marta", host: false },
  { nick: "Igor", host: false },
];
const guestView: LobbyPlayer[] = [
  { nick: "Bartek", host: true },
  { nick: "Ola", host: false },
  { nick: "Kasia 🎉", host: false },
  { nick: "Zosia", host: false },
];

// The round: five players in seat order, the host first (Ola); the guest's screens are Bartek's.
const roundPlayers: LobbyPlayer[] = [
  { nick: "Ola", host: true },
  { nick: "Bartek", host: false },
  { nick: "Kasia 🎉", host: false },
  { nick: "Zosia", host: false },
  { nick: "Kuba", host: false },
];
// Twenty players (the most a room is planned for): five nicks of 20 characters, the widest letters, emoji.
const twentyPlayers: LobbyPlayer[] = [
  "Ola",
  "Najdłuższy nick 20zn",
  "Kasia 🎉",
  "Bartłomiej Kowalczyk",
  "Zosia",
  "Kuba",
  "Małgorzata Wiśniewsk",
  "🦄 Jednorożec",
  "Igor",
  "Marta",
  "Przemysław Grzegorz",
  "Ania 🍕",
  "Szczepan Brzęczyszcz",
  "Tomek",
  "Ewa",
  "WWWWWWWWWWWWWWWWWWWW",
  "Jan",
  "Łukasz 🎮",
  "Natalia",
  "Krzysztof",
].map((nick, index) => ({ nick, host: index === 0 }));

// Sample questions: the ending after "Kto z nas najprawdopodobniej", as the Worker sends it; the long one is the
// longest in the base.
const QUESTION = "spóźniłby się na własne urodziny";
const LONG_QUESTION = "przeszedłby grę na najwyższym poziomie tylko po to, żeby się pochwalić";
const QUESTION_ID = "na-co-dzien-001";

// questions: the host's game's question list in the lobby (S-06); null until "Przejrzyj pytania", and for a guest.
function lobby(role: "host" | "guest", me: string, players: LobbyPlayer[]): RoomView {
  return { status: "lobby", role, me, players, round: null, requests: [], questionsLeft: null, questions: null };
}

// round: the question's number in the game, whether the host skipped the one before it (S-03) and who may vote in it
// (eligible, S-08). By default every player was in the room when the round opened, so all of them may vote in it, and
// no latecomer is waiting (requests; withRequests below).
function voting(
  role: "host" | "guest",
  me: string,
  players: LobbyPlayer[],
  voted: string[],
  question: string | null = QUESTION,
  round: { number?: number; afterSkip?: boolean; eligible?: string[] } = {},
): RoomView {
  return {
    status: "playing",
    role,
    me,
    players,
    round: {
      number: round.number ?? 1,
      question_id: QUESTION_ID,
      question_text: null,
      phase: "voting",
      eligible: round.eligible ?? players.map(({ nick }) => nick),
      voted,
      me_voted: voted.includes(me),
      after_skip: round.afterSkip ?? false,
      question,
    },
    requests: [],
    questionsLeft: null,
    questions: null,
  };
}

// results: [nick, votes] in seat order, every player of the round; ballots = votes + abstentions.
function revealed(
  role: "host" | "guest",
  me: string,
  players: LobbyPlayer[],
  results: [string, number][],
  abstained: number,
  question: string | null = QUESTION,
  questionsLeft = true,
): RoomView {
  const votes = results.reduce((sum, [, count]) => sum + count, 0);
  return {
    status: "playing",
    role,
    me,
    players,
    round: {
      number: 1,
      question_id: QUESTION_ID,
      question_text: null,
      phase: "revealed",
      results: results.map(([nick, count]) => ({ nick, votes: count })),
      abstained,
      ballots: votes + abstained,
      question,
    },
    requests: [],
    // Only the host learns whether the game has a question left.
    questionsLeft: role === "host" ? questionsLeft : null,
    questions: null,
  };
}

// The host skipped the last question of the game's pool: no round follows it, its votes are gone.
function skipped(role: "host" | "guest", me: string, players: LobbyPlayer[]): RoomView {
  return {
    status: "playing",
    role,
    me,
    players,
    round: { number: 7, phase: "skipped" },
    requests: [],
    questionsLeft: role === "host" ? false : null,
    questions: null,
  };
}

// The end of the evening: the room is closed, no round, no counts.
function closed(role: "host" | "guest", me: string, players: LobbyPlayer[]): RoomView {
  return { status: "closed", role, me, players, round: null, requests: [], questionsLeft: null, questions: null };
}

// The host's screen with latecomers waiting to be let in (S-08), in the order of asking; only the host gets them.
function withRequests(view: RoomView, requests: string[]): RoomView {
  return { ...view, requests };
}

// S-08: Kuba (the last seat) was let in while question 1 was voting: he sees it, and votes from the next question on.
const beforeKuba = ["Ola", "Bartek", "Kasia 🎉", "Zosia"];

// Ola 2, Kasia 2 (a tie, in seat order), three zeros, one abstention: 5 ballots from 5 players.
const fiveResults: [string, number][] = [
  ["Ola", 2],
  ["Bartek", 0],
  ["Kasia 🎉", 2],
  ["Zosia", 0],
  ["Kuba", 0],
];
// Decision D3: the host revealed after a single vote.
const oneVote: [string, number][] = [
  ["Ola", 0],
  ["Bartek", 0],
  ["Kasia 🎉", 1],
  ["Zosia", 0],
  ["Kuba", 0],
];
const noVotes: [string, number][] = roundPlayers.map(({ nick }) => [nick, 0]);
// 17 votes and 3 abstentions from 20 players: ties at 3, 2 and 1, and zeros.
const twentyCounts = [3, 2, 0, 3, 1, 0, 2, 1, 0, 0, 1, 0, 0, 2, 0, 1, 0, 0, 1, 0];
const twentyResults: [string, number][] = twentyPlayers.map(({ nick }, index) => [nick, twentyCounts[index]]);
// 20 players, only 5 got votes (15 votes, 5 abstentions): Karol's example of a readable pie.
const fewOfTwentyCounts = [5, 0, 0, 4, 0, 0, 3, 0, 0, 0, 2, 0, 0, 0, 0, 1, 0, 0, 0, 0];
const fewOfTwenty: [string, number][] = twentyPlayers.map(({ nick }, index) => [nick, fewOfTwentyCounts[index]]);
// 20 players, 11 got votes (16 votes, 4 abstentions): a pie of 11 slices.
const elevenOfTwentyCounts = [3, 2, 0, 2, 1, 0, 1, 1, 0, 0, 1, 0, 1, 2, 0, 1, 0, 0, 1, 0];
const elevenOfTwenty: [string, number][] = twentyPlayers.map(({ nick }, index) => [nick, elevenOfTwentyCounts[index]]);
// Every vote for one player: the pie is a full circle.
const allForOne: [string, number][] = [
  ["Ola", 0],
  ["Bartek", 0],
  ["Kasia 🎉", 4],
  ["Zosia", 0],
  ["Kuba", 0],
];
---

{isDev && (
  <Layout title="Stany pokoju">
    <main class="bg-background text-foreground min-h-screen p-6">
      <h1 class="text-2xl font-semibold">Stany pokoju</h1>
      <p class="text-muted-foreground mt-2 max-w-3xl text-sm">
        Te same klocki co na /, /j/… i /r/…, z przykładowymi danymi: strona nie pyta bazy i nie słucha zmian, więc listy
        graczy stoją w miejscu, a ekran czekania na hosta sam nigdzie nie przechodzi. Hover i focus-visible sprawdzasz
        na stanach 2, 9, 14, 25, 28, 36, 42, 45f, 64 i 69: najedź myszą na pola i przyciski albo przejdź Tabem. Wysłanie
        formularza na tej stronie naprawdę idzie do API (zalogowany host założy pokój), a „Wyloguj” w nagłówku naprawdę
        wylogowuje. Przyciski gry („Zacznij grę”, „Zagłosuj”, „Odsłoń wynik”, „Pomiń pytanie”, „Zakończ grę”, „Następne
        pytanie”, „Wpuść”, „Odrzuć”) niczego nie wysyłają: głos od razu pokazuje „Głos oddany”, pytania „Na pewno…?” i
        „Anuluj” działają naprawdę, a wysłana akcja hosta zostaje w stanie wysyłania. Przełącznik „Koło” / „Paski” w
        odsłonie działa naprawdę, tylko na swoim ekranie. Od 1024 px stany pokoju mają szerokość strony, jak na
        laptopie; pokój w prawdziwym oknie, z szerokim nagłówkiem, pokazuje /dev/room-window.
      </p>

      <div class="mt-10 flex flex-col gap-6">
        <h2 class="border-b pb-2 text-lg font-semibold">Nagłówek</h2>
        <div class="grid items-start justify-items-center gap-10 md:grid-cols-2 xl:grid-cols-3">
          <section id="header-host" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">a. Zalogowany host</h2>
            <AppHeader signedIn />
          </section>

          <section id="header-guest" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">b. Gość lub niezalogowany</h2>
            <AppHeader signedIn={false} />
          </section>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-6">
        <h2 class="border-b pb-2 text-lg font-semibold">Strona główna</h2>
        <div class="grid items-start justify-items-center gap-10 md:grid-cols-2 xl:grid-cols-3">
          <section id="home-guest" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">1. Niezalogowany</h2>
            <Landing titleAs="h2" />
          </section>

          <section id="new-default" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">2. Nowa gra: domyślny · hover · focus-visible</h2>
            <RoomCard titleAs="h2" {...newGameCard}>
              <NewGameForm categories={categories} preview={{ idPrefix: "new-default" }} client:load />
            </RoomCard>
          </section>

          <section id="new-nick-error" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">3. Błąd: za długi nick</h2>
            <RoomCard titleAs="h2" {...newGameCard}>
              <NewGameForm
                categories={categories}
                preview={{ idPrefix: "new-nick-error", nick: "Bardzo długi nick gracza", showErrors: true }}
                client:load
              />
            </RoomCard>
          </section>

          <section id="new-no-categories" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">4. Błąd: brak kategorii</h2>
            <RoomCard titleAs="h2" {...newGameCard}>
              <NewGameForm
                categories={categories}
                preview={{ idPrefix: "new-no-categories", nick: "Ola", noCategories: true, showErrors: true }}
                client:load
              />
            </RoomCard>
          </section>

          <section id="new-open-room" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">5. Z otwartym pokojem</h2>
            <div class="flex flex-col gap-6">
              <OpenRoomNotice roomId={ROOM_ID} players={4} status="lobby" />
              <RoomCard titleAs="h2" {...newGameCard}>
                <NewGameForm
                  categories={categories}
                  roomToClose={{ players: 4 }}
                  preview={{ idPrefix: "new-open-room" }}
                  client:load
                />
              </RoomCard>
            </div>
          </section>

          <section id="new-open-game" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">5b. Z grą w toku</h2>
            <div class="flex flex-col gap-6">
              <OpenRoomNotice roomId={ROOM_ID} players={5} status="playing" />
              <RoomCard titleAs="h2" {...newGameCard}>
                <NewGameForm
                  categories={categories}
                  roomToClose={{ players: 5 }}
                  preview={{ idPrefix: "new-open-game" }}
                  client:load
                />
              </RoomCard>
            </div>
          </section>

          <section id="new-confirm-close" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">6. Potwierdzenie: zamknięcie pokoju z gośćmi</h2>
            <div class="flex flex-col gap-6">
              <OpenRoomNotice roomId={ROOM_ID} players={4} status="lobby" />
              <RoomCard titleAs="h2" {...newGameCard}>
                <NewGameForm
                  categories={categories}
                  roomToClose={{ players: 4 }}
                  preview={{ idPrefix: "new-confirm-close", nick: "Ola", confirming: true }}
                  client:load
                />
              </RoomCard>
            </div>
          </section>

          <section id="new-pending" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">7. Wysyłanie</h2>
            <RoomCard titleAs="h2" {...newGameCard}>
              <NewGameForm
                categories={categories}
                preview={{ idPrefix: "new-pending", nick: "Ola", pending: true }}
                client:load
              />
            </RoomCard>
          </section>

          <section id="new-server-error" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">8. Błąd: serwer (po przekierowaniu)</h2>
            {/* Empty nick: after the redirect the real form is empty too, because the nick never goes in a URL. */}
            <RoomCard titleAs="h2" {...newGameCard}>
              <NewGameForm
                categories={categories}
                serverError={roomErrorMessage("try_again")}
                preview={{ idPrefix: "new-server-error" }}
                client:load
              />
            </RoomCard>
          </section>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-6">
        <h2 class="border-b pb-2 text-lg font-semibold">Link gościa (/j/…)</h2>
        <div class="grid items-start justify-items-center gap-10 md:grid-cols-2 xl:grid-cols-3">
          <section id="join-default" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">9. Dołącz: domyślny · hover · focus-visible</h2>
            <RoomCard titleAs="h2" {...joinCard}>
              <JoinForm linkToken={LINK_TOKEN} preview={{ idPrefix: "join-default" }} client:load />
            </RoomCard>
          </section>

          <section id="join-nick-taken" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">10. Błąd: nick zajęty (po przekierowaniu)</h2>
            {/* Empty nick, as on the real page after the redirect. */}
            <RoomCard titleAs="h2" {...joinCard}>
              <JoinForm
                linkToken={LINK_TOKEN}
                serverError={roomErrorMessage("nick_taken")}
                preview={{ idPrefix: "join-nick-taken" }}
                client:load
              />
            </RoomCard>
          </section>

          <section id="join-pending" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">11. Wysyłanie</h2>
            <RoomCard titleAs="h2" {...joinCard}>
              <JoinForm
                linkToken={LINK_TOKEN}
                preview={{ idPrefix: "join-pending", nick: "Ola", pending: true }}
                client:load
              />
            </RoomCard>
          </section>

          <section id="join-unknown" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">12. Nieznany link</h2>
            <RoomMessage titleAs="h2" title="Nie znamy tego linku." text="Sprawdź, czy skopiował się cały." />
          </section>

          <section id="join-closed" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">13. Gra skończona</h2>
            <RoomMessage titleAs="h2" title="Ta gra już się skończyła." text="Poproś hosta o nowy link." />
          </section>

          <section id="join-request" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">
              64. Gra w toku: prośba o wejście · hover · focus-visible
            </h2>
            <RoomCard titleAs="h2" {...requestCard}>
              <JoinForm linkToken={LINK_TOKEN} variant="request" preview={{ idPrefix: "join-request" }} client:load />
            </RoomCard>
          </section>

          <section id="join-request-waiting" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">65. Prośba wysłana: czekanie na hosta</h2>
            <JoinWaiting roomId={ROOM_ID} linkToken={LINK_TOKEN} nick="Kuba" preview={{}} client:load />
          </section>

          <section id="join-request-waiting-error" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">66. Czekanie: błąd odświeżania (nick 20 znaków)</h2>
            <JoinWaiting
              roomId={ROOM_ID}
              linkToken={LINK_TOKEN}
              nick="Najdłuższy nick 20zn"
              preview={{ refreshFailed: true }}
              client:load
            />
          </section>

          <section id="join-request-rejected" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">67. Host nie wpuścił: „Poproś jeszcze raz”</h2>
            {/* The nick asked with before, as the real page has it from the latecomer's own request. */}
            <RoomCard titleAs="h2" {...requestAgainCard}>
              <JoinForm
                linkToken={LINK_TOKEN}
                variant="request-again"
                initialNick="Kuba"
                preview={{ idPrefix: "join-request-rejected" }}
                client:load
              />
            </RoomCard>
          </section>

          <section id="join-request-closed" class="flex w-full max-w-lg flex-col gap-3">
            <h2 class="text-muted-foreground text-sm font-medium">68. Czekający: gra się skończyła</h2>
            <JoinWaiting roomId={ROOM_ID} linkToken={LINK_TOKEN} nick="Kuba" preview={{ closed: true }} client:load />
          </section>
        </div>
      </div>

      <div class="mt-10 flex flex-col gap-6">
        <h2 class="border-b pb-2 text-lg font-semibold">Pokój (/r/…)</h2>
        <div class="grid items-start justify-items-center gap-10 md:grid-cols-2 lg:grid-cols-1">
          <section id="lobby-host-1" class:list={["flex w-full flex-col gap-3", ROOM_FRAME]}>
            <h2 class="text-muted-foreground text-sm font-medium">14. Host, 1 gracz · hover · focus-visible</h2>
            <RoomScreen
              roomId={ROOM_ID}
              initial={lobby("host", "Ola", hostAlone)}
              linkUrl={LINK_URL}
              realtime={null}
              preview={{ idPrefix: "lobby-host-1" }}
              client:load
            />
          </section>

          <section id="lobby-host-8" class:list={["flex w-full flex-col gap-3", ROOM_FRAME]}>
            <h2 class="text-muted-foreground text-sm font-medium">15. Host, 8 graczy (nick 20 znaków, emotka)</h2>
            <RoomScreen
              roomId={ROOM_ID}
              initial={lobby("host", "Ola", eightPlayers)}
              linkUrl={LINK_URL}
              realtime={null}
              preview={{ idPrefix: "lobby-host-8" }}
              client:load
            />
          </section>

          <section id="lobby-copied" class:list={["flex w-full flex-col gap-3", ROOM_FRAME]}>
            <h2 class="text-muted-foreground text-sm font-medium">16. Skopiowano</h2>
            <RoomScreen
              roomId={ROOM_ID}
              initial={lobby("host", "Ola", fewPlayers)}
              linkUrl={LINK_URL}
              realtime={null}
              preview={{ idPrefix: "lobby-copied", copied: true }}
              client:load
            />
          </section>

          <section id="lobby-refresh-failed" class:list={["flex w-full flex-col gap-3", ROOM_FRAME]}>
            <h2 class="text-muted-foreground text-sm font-medium">17. Błąd odświeżania listy</h2>
            <RoomScreen
              roomId={ROOM_ID}
              initial={lobby("host", "Ola", fewPlayers)}
