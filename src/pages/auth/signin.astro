---
import Layout from "@/layouts/Layout.astro";
import SignInCard from "@/components/auth/SignInCard.astro";
import SignInForm from "@/components/auth/SignInForm";
import { authErrorMessage } from "@/lib/auth-errors";

const error = authErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title="Zaloguj się">
  <main class="bg-background flex min-h-screen items-center justify-center p-4">
    <SignInCard>
      <SignInForm serverError={error} client:load />
    </SignInCard>
  </main>
</Layout>
