---
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";

// The sign-in card around the form (slot), shared by /auth/signin and /dev/ui-kitchen-sink so the states page shows
// the real screen. The states page has its own h1, so there the title is an h2.
interface Props {
  titleAs?: "h1" | "h2";
}

const { titleAs: Title = "h1" } = Astro.props;
---

<Card className="w-full max-w-sm">
  <CardHeader className="text-center">
    <CardTitle className="text-2xl">
      <Title>Zaloguj się</Title>
    </CardTitle>
    <CardDescription className="text-balance">Konto ma tylko osoba prowadząca. Goście grają bez konta.</CardDescription>
  </CardHeader>
  <CardContent>
    <slot />
  </CardContent>
  <CardFooter className="text-muted-foreground justify-center gap-1 text-sm">
    Nie masz konta?
    <a
      href="/auth/signup"
      class="text-primary hover:text-foreground focus-visible:ring-ring/50 rounded-sm underline underline-offset-4 outline-hidden focus-visible:ring-3"
    >
      Załóż je
    </a>
  </CardFooter>
</Card>
