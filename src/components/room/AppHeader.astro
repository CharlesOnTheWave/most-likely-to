---
import { Button } from "@/components/ui/button";
import { ROOM_FRAME } from "@/components/room/room-frame";

// Top bar of the game screens. A signed-in host also sees "Wyloguj", but not their e-mail: the host often shares this
// screen on Discord (Karol, phase 4). For a guest the game name is plain text, so it does not lead out of the lobby to
// the sign-in invitation.
interface Props {
  // Only the dev previews pass it, e.g. /dev/room-states to show both variants; the real pages omit it and the session
  // decides.
  signedIn?: boolean;
  // The room page's frame (src/components/room/room-frame.ts), wide from lg: on every screen of the room, so the
  // header does not jump between them. Only /r/[id] and /dev/room-window pass it; without it the header is the 512 px
  // column of / and /j/[token].
  wide?: boolean;
}

const signedIn = Astro.props.signedIn ?? Boolean(Astro.locals.user);
const width = Astro.props.wide ? ROOM_FRAME : "max-w-lg";
---

<header class="border-b">
  <div class:list={["mx-auto flex w-full items-center justify-between gap-4 px-4 py-3", width]}>
    {signedIn ? (
      <a
        href="/"
        class="focus-visible:ring-ring/50 rounded-sm font-semibold whitespace-nowrap outline-hidden focus-visible:ring-3"
      >
        Most Likely To
      </a>
    ) : (
      <span class="font-semibold whitespace-nowrap">Most Likely To</span>
    )}
    {signedIn && (
      <form method="POST" action="/api/auth/signout">
        <Button type="submit" variant="ghost" size="sm">
          Wyloguj
        </Button>
      </form>
    )}
  </div>
</header>
