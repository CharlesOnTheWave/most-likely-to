---
// The centred message of the room pages (unknown or closed link, not in the room, an error), shared with
// /dev/room-states so the states page shows the real screen. The states page has its own h1, so there the title is an h2.
interface Props {
  title: string;
  // roomErrorMessage() is typed string | null; the pages only pass a known code, so in practice it is always text.
  text: string | null;
  titleAs?: "h1" | "h2";
}

const { title, text, titleAs: Title = "h1" } = Astro.props;
---

<section class="flex flex-col items-center gap-4 py-12 text-center">
  <Title class="text-2xl font-semibold text-balance">{title}</Title>
  <p class="text-muted-foreground">{text}</p>
</section>
