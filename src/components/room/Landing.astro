---
import { buttonVariants } from "@/components/ui/button";

// / for someone who is not signed in: only the host has an account, a guest comes in through the host's link.
// The states page has its own h1, so there the title is an h2.
interface Props {
  titleAs?: "h1" | "h2";
}

const { titleAs: Title = "h1" } = Astro.props;
---

<section class="flex flex-col items-center gap-6 py-12 text-center">
  <Title class="text-3xl font-semibold text-balance">Kto z nas najprawdopodobniej…?</Title>
  <p class="text-muted-foreground max-w-md text-balance">
    Wszyscy widzą to samo pytanie, każdy oddaje jeden anonimowy głos, a wynik pojawia się po ostatnim głosie.
  </p>
  <a href="/auth/signin" class:list={buttonVariants({ size: "lg" })}>
    Zaloguj się, żeby założyć grę
  </a>
  <p class="text-muted-foreground text-sm">Masz link od hosta? Otwórz go, żeby dołączyć.</p>
</section>
